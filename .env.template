# User Permissions
PUID=1000
PGID=1000

# Timezone
TZ=Europe/Berlin

# Directories (Absolute paths on the Host)
# You can use external SSD paths here
DATA_ROOT=/mnt/ssd/docker-data
MEDIA_ROOT=/mnt/ssd/media
DOCS_ROOT=/mnt/ssd/documents

# Secrets
PAPERLESS_DB_PASS=change_me_please
MINIFLUX_DB_PASS=change_me_please
MINIFLUX_ADMIN_PASS=change_me_please
POSTGRES_USER=postgres

# Pi-hole
# The admin password for the Pi-hole web interface
PIHOLE_PASSWORD=change_me_please
# The LAN IP address of the host running Pi-hole (used for DNS resolution)
PIHOLE_HOST_IP=192.168.1.x


# Firefly III
FIREFLY_DB_PASS=<your-db-password>
FIREFLY_APP_KEY=<32-character-random-string>
# You can generate a personal access token from the Firefly III UI and use it here to enable the importer
# head /dev/urandom | LC_ALL=C tr -dc 'a-zA-Z0-9' | head -c 32
FIREFLY_IMPORTER_TOKEN=<personal-access-token-from-firefly-ui>

# Caddy (Reverse Proxy & SSL)
# Your domain name (subdomains will be created automatically: paperless.example.com, miniflux.example.com, etc.)
CADDY_DOMAIN=example.com
# Your Tailscale IP (run: tailscale ip -4). Caddy will only listen on this interface.
TAILSCALE_IP=100.x.x.x
# DNS provider plugin for ACME DNS-01 challenge (used by xcaddy build)
# Common options: porkbun, cloudflare, duckdns, namecheap, route53, godaddy
# Full list: https://github.com/orgs/caddy-dns/repositories
CADDY_DNS_PLUGIN=porkbun
# Porkbun API credentials (https://porkbun.com/account/api)
PORKBUN_API_KEY=your_porkbun_api_key_here
PORKBUN_API_SECRET_KEY=your_porkbun_api_secret_key_here