# =============================================================================
# SYSTEM
# =============================================================================
PUID=1000
PGID=1000
TZ=Europe/Berlin

# =============================================================================
# STORAGE
# =============================================================================
# VM disk — databases, app config, search indexes
# This is a regular directory on the VM's own filesystem (no mount needed).
# The VM disk sits on the host SSD and is backed up automatically by Proxmox PBS.
# Recommended: /opt/docker-data (follows Linux FHS for third-party app data)
DATA_ROOT=/opt/docker-data

# External HDD — documents, media, photos, sync data (bulk storage)
# Mount point of your USB HDD. Change this to match your actual mount path.
# Tip: add "nofail" to this drive's /etc/fstab entry so the VM boots normally
#      even if the HDD is disconnected.
# Example fstab entry:
#   UUID=xxxx-xxxx  /mnt/hdd  ext4  defaults,nofail,x-systemd.device-timeout=5  0  2
HDD_ROOT=/mnt/hdd

# =============================================================================
# NETWORKING
# =============================================================================
# Your domain — used in service URLs (e.g. paperless.example.com)
# Configure the actual subdomain routing in your NPM (Nginx Proxy Manager)
DOMAIN=example.com

# Syncthing hostname — shows in the Syncthing web UI and on other devices
# Set to something recognizable (e.g. your hostname or "homelab-sync")
SYNCTHING_HOSTNAME=homelab-sync

# =============================================================================
# PAPERLESS-NGX
# =============================================================================
POSTGRES_USER=postgres
PAPERLESS_DB_PASS=change_me_please

# =============================================================================
# MINIFLUX
# =============================================================================
MINIFLUX_DB_PASS=change_me_please
MINIFLUX_ADMIN_PASS=change_me_please

# =============================================================================
# FIREFLY III
# =============================================================================
FIREFLY_DB_PASS=change_me_please

# Generate with: head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32
FIREFLY_APP_KEY=change_me_to_32_char_random_string

# Generate in Firefly UI after first login: Options → Profile → Personal Access Tokens
FIREFLY_IMPORTER_TOKEN=change_me_after_first_login

# =============================================================================
# IMMICH (optional service)
# =============================================================================
# Pin to a specific release: https://github.com/immich-app/immich/releases
# Using "release" always pulls the latest stable — change to a version tag
# (e.g. v1.130.0) once you want to control updates manually
IMMICH_VERSION=release
IMMICH_DB_PASS=change_me_please
