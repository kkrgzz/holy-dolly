# =============================================================================
# SYSTEM — all machines
# =============================================================================
PUID=1000
PGID=1000
TZ=Europe/Berlin

# =============================================================================
# STORAGE — all machines
# =============================================================================
# VM disk — databases, app config, search indexes.
# Regular directory on the VM filesystem, no mount needed.
# Backed up automatically by Proxmox PBS with the VM.
# Recommended: /opt/docker-data
DATA_ROOT=/opt/docker-data

# =============================================================================
# STORAGE — private machine only
# =============================================================================
# External HDD — documents, media, photos, sync data.
# Change to match your actual HDD mount path.
# Add "nofail" to /etc/fstab so the VM boots even if HDD is disconnected:
#   UUID=xxxx-xxxx  /mnt/hdd  ext4  defaults,nofail,x-systemd.device-timeout=5  0  2
HDD_ROOT=/mnt/hdd

# =============================================================================
# NETWORKING — all machines
# =============================================================================
# Your domain — used in service URLs (e.g. paperless.example.com)
# Point subdomains to the correct machine IP in NPM.
DOMAIN=example.com

# =============================================================================
# PRIVATE SERVICES
# Run with: make up-private
# =============================================================================

# --- Paperless-NGX ---
POSTGRES_USER=postgres
PAPERLESS_DB_PASS=change_me_please

# --- Syncthing ---
# Shown in the Syncthing web UI and on other devices
SYNCTHING_HOSTNAME=homelab-sync

# --- Firefly III ---
FIREFLY_DB_PASS=change_me_please
# Generate: head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32
FIREFLY_APP_KEY=change_me_to_32_char_random_string
# Generate in Firefly UI after first login: Options → Profile → Personal Access Tokens
FIREFLY_IMPORTER_TOKEN=change_me_after_first_login

# --- Immich ---
# https://github.com/immich-app/immich/releases
IMMICH_VERSION=release
IMMICH_DB_PASS=change_me_please

# =============================================================================
# PUBLIC SERVICES
# Run with: make up-public
# =============================================================================

# --- Miniflux ---
MINIFLUX_DB_PASS=change_me_please
MINIFLUX_ADMIN_PASS=change_me_please

# --- n8n ---
N8N_DB_PASS=change_me_please
# Encrypts all credentials stored in n8n.
# CRITICAL: back this up. If lost, all stored credentials become unreadable.
# Generate: head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32
N8N_ENCRYPTION_KEY=change_me_to_32_char_random_string

# --- Trilium Notes ---
# No secrets needed — account is created on first login.

# --- Wallabag ---
WALLABAG_DB_PASS=change_me_please
# Random 32-char string — used to sign cookies and CSRF tokens
WALLABAG_SECRET=change_me_to_32_char_random_string
